{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoo.example/schemas/app-events-v1.json",
  "title": "Zoo event delivery v1",
  "type": "object",
  "required": [
    "delivery_id",
    "ack_token",
    "event",
    "attempt"
  ],
  "additionalProperties": false,
  "properties": {
    "delivery_id": {
      "type": "string"
    },
    "ack_token": {
      "type": "string",
      "description": "Acknowledges only this delivery attempt; keep private"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "version",
        "type",
        "occurred_at",
        "actor_id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "message.created",
            "message.updated",
            "message.deleted",
            "app.mentioned",
            "reaction.added",
            "reaction.removed",
            "member.joined",
            "member.left",
            "channel.created",
            "channel.updated",
            "channel.deleted",
            "file.created",
            "app.installed",
            "app.uninstalled",
            "command.invoked",
            "action.invoked",
            "view.submitted",
            "shortcut.invoked",
            "link.shared",
            "home.opened"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "type": "string"
        },
        "channel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": "object"
        },
        "previous": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
