# syntax=docker/dockerfile:1
# Align Rust with rust-toolchain.toml and glibc with the Debian 12 distroless runtime.
FROM rust:1.99-bookworm AS build-env

ARG DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db?schema=public"

WORKDIR /app

COPY backend/ /app
# backend は E2EE の署名の検証に crates/zoo-crypto を path で依存する（../crates/zoo-crypto）。
COPY crates/zoo-crypto/ /crates/zoo-crypto
# events.rs embeds this public contract at compile time.
COPY docs/slack-event-coverage.json /docs/slack-event-coverage.json

# Rebuild the application even if restored artifacts have newer timestamps.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo clean --locked --release --package backend && \
    cargo build --locked --release --bin zoo_backend --bin zoo_dispatcher --bin zoo_slack_worker --bin zoo_slack_reformat && \
    cp /app/target/release/zoo_backend /zoo_backend && \
    cp /app/target/release/zoo_dispatcher /zoo_dispatcher && \
    cp /app/target/release/zoo_slack_worker /zoo_slack_worker && \
    cp /app/target/release/zoo_slack_reformat /zoo_slack_reformat


FROM gcr.io/distroless/cc-debian12:nonroot

USER nonroot

COPY --chown=nonroot:nonroot --from=build-env /zoo_backend /zoo_dispatcher /zoo_slack_worker /zoo_slack_reformat /home/nonroot/

# 同じイメージで 4 つのバイナリを持つ (zoo_slack_reformat は 1 回限りの修正で、`kubectl exec` で動かす)。zoo-dispatcher と zoo-slack-worker の Deployment は command で
# /home/nonroot/zoo_dispatcher、/home/nonroot/zoo_slack_worker を指定する。
CMD ["/home/nonroot/zoo_backend"]

