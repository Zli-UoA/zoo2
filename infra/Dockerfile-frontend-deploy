FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
# pnpm のバージョンは package.json の devEngines に揃える（corepack は devEngines を読まない）。
# フィールドが無いと pnpm@undefined を入れようとして分かりにくく失敗するため、先に検証する。
RUN set -eu; \
  version="$(node -p 'const pm = require("./package.json").devEngines?.packageManager; pm?.name === "pnpm" && pm.version ? pm.version : ""')"; \
  if [ -z "$version" ]; then \
    echo "package.json must set devEngines.packageManager to pnpm with a version" >&2; \
    exit 1; \
  fi; \
  npm install --global "pnpm@$version"; \
  pnpm install --frozen-lockfile

COPY frontend/ ./
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SHAPE_MODE=proxy
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
# Nitro-specific settings take precedence over shared deployment HOST/PORT.
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

COPY --from=build --chown=node:node /app/.output/ ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r => { if (r.status !== 200) console.error('Frontend healthcheck HTTP', r.status); process.exit(r.status === 200 ? 0 : 1); }).catch(e => { console.error('Frontend healthcheck', e.cause?.code ?? e.message); process.exit(1); })"
CMD ["node", "server/index.mjs"]
