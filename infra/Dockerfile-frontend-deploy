FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
# pnpm のバージョンは package.json の devEngines に揃える（corepack は devEngines を読まない）。
# フィールドが無いと pnpm@undefined を入れようとして分かりにくく失敗するため、先に検証する。
RUN set -eu; \
  version="$(node -p 'const pm = require("./package.json").devEngines?.packageManager; pm?.name === "pnpm" && pm.version ? pm.version : ""')"; \
  if [ -z "$version" ]; then \
    echo "package.json must set devEngines.packageManager to pnpm with a version" >&2; \
    exit 1; \
  fi; \
  npm install --global "pnpm@$version"; \
  pnpm install --frozen-lockfile

COPY frontend/ ./
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SHAPE_MODE=proxy
ARG VITE_PREVIEW_AUTH="false"
ENV VITE_PREVIEW_AUTH=$VITE_PREVIEW_AUTH
# SPA の OIDC PKCE 設定はビルド時に埋め込まれる。未設定（空）なら dev の
# X-Dev-User 動作のまま。Kanidm の確定値は #50 で差し替える。
ARG VITE_OIDC_ISSUER=""
ARG VITE_OIDC_CLIENT_ID=""
ARG VITE_OIDC_REDIRECT_URI=""
ARG VITE_OIDC_SCOPE=""
ARG VITE_OIDC_RESOURCE=""
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI=""
ENV VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE
ENV VITE_OIDC_RESOURCE=$VITE_OIDC_RESOURCE
ENV VITE_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_OIDC_POST_LOGOUT_REDIRECT_URI
RUN pnpm build
# CSP の script-src 用に、index.html に埋め込まれたインライン script の
# SHA-256 を列挙する。index.html と同時に生成するため常に一致する。
COPY infra/csp-hashes.mjs /tmp/csp-hashes.mjs
RUN node /tmp/csp-hashes.mjs dist/client/index.html csp-script-src.txt

FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS runtime
COPY --from=build /app/dist/client/ /usr/share/nginx/html/
COPY --from=build /app/csp-script-src.txt /etc/nginx/csp-script-src.txt
# 起動時に /etc/nginx/templates/*.template を envsubst する公式 entrypoint を使う。
# filter で CSP_ 接頭辞だけを置換対象にし、nginx の $uri などは触らない。
COPY infra/frontend-nginx.conf /etc/nginx/templates/default.conf.template
COPY infra/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint.sh
ENV NGINX_ENVSUBST_FILTER="^(CSP_|MEDIA_PROXY_URL$)"
# 既定は同一オリジンのみ。ステージングでは Kanidm や R2 のオリジンを渡す。
ENV CSP_CONNECT_SRC=""
ENV CSP_STORAGE_SRC=""
ENV CSP_APP_IMAGE_SRC=""
ENV MEDIA_PROXY_URL=""
ENTRYPOINT ["/usr/local/bin/frontend-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1

