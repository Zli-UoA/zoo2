        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (zoo_ws_active_connections)",
          "legendFormat": "WS {{kind}}",
          "refId": "B"
        }
      ],
      "title": "Active SSE & WebSocket Connections",
      "type": "timeseries"
    },
    {
