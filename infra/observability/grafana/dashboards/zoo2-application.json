  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["zoo2", "observability"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(zoo_http_requests_total, service)",
        "includeAll": true,
        "multi": true,
        "name": "service",
        "query": "label_values(zoo_http_requests_total, service)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(zoo_http_requests_total{service=~\"$service\"}, route)",
        "includeAll": true,
        "multi": true,
        "name": "route",
        "query": "label_values(zoo_http_requests_total{service=~\"$service\"}, route)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "includeAll": true,
        "multi": true,
        "name": "level",
        "options": [
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" }
        ],
        "query": "error,warn,info,debug",
        "type": "custom"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "label": "Route substring (Logs)",
        "name": "route_filter",
        "query": "",
        "type": "textbox"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "label": "Trace ID",
        "name": "trace_id",
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Zoo2 Application Observability",
  "uid": "zoo2-observability",
  "version": 1
