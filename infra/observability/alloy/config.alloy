// ローカル検証用 Grafana Alloy 設定。
// `.local/logs/*.jsonl` へ出力された 1 行 JSON ログ（LOG_FORMAT=json）を監視し、
// 許可フィールドのみ抽出・低カーディナリティラベル付与・トークン保護を行って Loki へ送信する。
// （OTLP トレースは `--profile traces` 起動時の Tempo が :4317 / :4318 で直接受信する）

local.file_match "zoo_logs" {
  path_targets = [{
    __path__ = "/var/log/zoo/*.jsonl",
  }]
  sync_period = "5s"
}

loki.source.file "zoo_logs" {
  targets    = local.file_match.zoo_logs.targets
  forward_to = [loki.process.zoo_safe.receiver]
}

loki.process "zoo_safe" {
  // 万一の Bearer トークン混入を防ぐ防御的マスキング
  stage.replace {
    expression = "(Bearer\\s+[A-Za-z0-9._~+/=-]+)"
    replace    = "Bearer [REDACTED]"
  }

  // zoo2 の JsonLogFormat / POST /api/telemetry が出力する許可フィールドのみを抽出する
  stage.json {
    expressions = {
      timestamp         = "timestamp",
      level             = "level",
      service           = "service",
      target            = "target",
      event             = "event",
      message           = "message",
      trace_id          = "trace_id",
      span_id           = "span_id",
      frontend_trace_id = "frontend_trace_id",
      frontend_span_id  = "frontend_span_id",
      span              = "span",
      method            = "method",
      route             = "route",
      http_status       = "http_status",
      duration_ms       = "duration_ms",
      error_class       = "error_class",
      error_summary     = "error_summary",
      category          = "category",
      metric            = "metric",
      rating            = "rating",
      shape             = "shape",
      state             = "state",
      candidate_type    = "candidate_type",
      rtt_ms            = "rtt_ms",
      loss_ratio        = "loss_ratio",
    }
  }

  // zoo_frontend ログでは /api/telemetry のインジェスト trace ではなく原因側トレースを trace_id / span_id へ昇格する
  stage.template {
    source   = "ingest_trace_id"
    template = "{{ if and .frontend_trace_id .trace_id }}{{ .trace_id }}{{ end }}"
  }

  stage.template {
    source   = "trace_id"
    template = "{{ if .frontend_trace_id }}{{ .frontend_trace_id }}{{ else }}{{ .trace_id }}{{ end }}"
  }

  stage.template {
    source   = "span_id"
    template = "{{ if .frontend_span_id }}{{ .frontend_span_id }}{{ else }}{{ .span_id }}{{ end }}"
  }

  // 許可フィールドのみで JSON ログ行を再構築し、未定義フィールド（user_id 等の万一の混入）を本文から破棄する
  stage.template {
    source   = "safe_output"
    template = `{{- $out := dict "timestamp" .timestamp "level" .level "service" .service "target" .target -}}{{- if .event -}}{{- $_ := set $out "event" .event -}}{{- end -}}{{- if .trace_id -}}{{- $_ := set $out "trace_id" .trace_id -}}{{- end -}}{{- if .span_id -}}{{- $_ := set $out "span_id" .span_id -}}{{- end -}}{{- if .ingest_trace_id -}}{{- $_ := set $out "ingest_trace_id" .ingest_trace_id -}}{{- end -}}{{- if .span -}}{{- $_ := set $out "span" .span -}}{{- end -}}{{- if .method -}}{{- $_ := set $out "method" .method -}}{{- end -}}{{- if .route -}}{{- $_ := set $out "route" .route -}}{{- end -}}{{- if .http_status -}}{{- $_ := set $out "http_status" .http_status -}}{{- end -}}{{- if .duration_ms -}}{{- $_ := set $out "duration_ms" .duration_ms -}}{{- end -}}{{- if .error_class -}}{{- $_ := set $out "error_class" .error_class -}}{{- end -}}{{- if .error_summary -}}{{- $_ := set $out "error_summary" .error_summary -}}{{- end -}}{{- if .category -}}{{- $_ := set $out "category" .category -}}{{- end -}}{{- if .metric -}}{{- $_ := set $out "metric" .metric -}}{{- end -}}{{- if .rating -}}{{- $_ := set $out "rating" .rating -}}{{- end -}}{{- if .shape -}}{{- $_ := set $out "shape" .shape -}}{{- end -}}{{- if .state -}}{{- $_ := set $out "state" .state -}}{{- end -}}{{- if .candidate_type -}}{{- $_ := set $out "candidate_type" .candidate_type -}}{{- end -}}{{- if .rtt_ms -}}{{- $_ := set $out "rtt_ms" .rtt_ms -}}{{- end -}}{{- if .loss_ratio -}}{{- $_ := set $out "loss_ratio" .loss_ratio -}}{{- end -}}{{- if .message -}}{{- $_ := set $out "message" .message -}}{{- end -}}{{- toJson $out -}}`
  }

  stage.output {
    source = "safe_output"
  }

  stage.timestamp {
    source            = "timestamp"
    format            = "RFC3339Nano"
    action_on_failure = "skip"
  }

  // ストリーム爆発を避けるため、ラベルは低カーディナリティ値に限定する
  stage.labels {
    values = {
      service     = "",
      level       = "",
      error_class = "",
      category    = "",
    }
  }

  // 高カーディナリティ・検索用属性は structured metadata に格納する
  stage.structured_metadata {
    values = {
      trace_id        = "",
      span_id         = "",
      ingest_trace_id = "",
      target          = "",
      span            = "",
      method          = "",
      route           = "",
      http_status     = "",
      duration_ms     = "",
      metric          = "",
      rating          = "",
      shape           = "",
      state           = "",
      candidate_type  = "",
      rtt_ms          = "",
      loss_ratio      = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
