FROM arigaio/atlas:1.3.4-alpine AS atlas
FROM postgres:16-alpine
COPY --from=atlas /bin/atlas /usr/local/bin/atlas
WORKDIR /
COPY infra/db/atlas.hcl /db/atlas.hcl
COPY infra/db/schema.sql /db/schema.sql
COPY infra/db/migrations/ /db/migrations/
COPY infra/db/migrate.sh /db/migrate.sh
# Preview jobs call /atlas directly; keep recovery through the shared entrypoint.
RUN ln -s /db/migrate.sh /atlas && atlas version && /atlas version
ENTRYPOINT ["/db/migrate.sh"]
