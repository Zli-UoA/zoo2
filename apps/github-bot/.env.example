BOT_CONFIG=config.json
BOT_DATABASE=data/github-bot.sqlite
BOT_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
ZOO_URL=https://zoo.example.com
ZOO_ACCESS_TOKEN=replace-with-app-access-token
ZOO_REFRESH_TOKEN=replace-with-app-refresh-token
ZOO_SIGNING_SECRET=replace-with-app-signing-secret
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_FILE=/absolute/path/github-app.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Docker Compose mounts this host path at /run/secrets/github.pem.
GITHUB_PRIVATE_KEY_PATH=/absolute/path/github-app.pem
HOST=0.0.0.0
PORT=3001
