# Shape 接続先の切替: proxy = バックエンドの Shape プロキシ経由 (既定・本番と同じ経路) /
# direct = Electric 直結 (開発専用・認可を迂回)
# 未設定なら proxy。不正な値は起動時にエラーになります。
VITE_SHAPE_MODE=proxy

# proxy モードの開発では必須: 現在ユーザー (X-Dev-User ヘッダ)。DB の users に存在する
# ユーザーの id を指定してください。未設定だと proxy モードの開発は起動時にエラーになります
# (direct では不要)。バックエンドの DEV_DEFAULT_USER_ID (既定 00000000-0000-0000-0000-000000000001)
# と同じ値にすると、ヘッダが無いときの既定ユーザーと一致します。
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# 書き込み後の楽観更新の待ち方: awaitTxId (既定) / awaitMatch / skip
# awaitTxId は REST が返す txid を Electric が配信するまで待つ。txid 非対応環境では
# awaitMatch (operation と行 id で照合) や skip (待機しない) に切り替えられます。
VITE_TXID_MODE=awaitTxId

# direct モードで参照する Electric の Shape エンドポイント
VITE_ELECTRIC_SHAPE_URL=http://localhost:3000/v1/shape

# REST API と proxy モードのベース URL
VITE_API_BASE_URL=http://localhost:8000

# Shape プロキシのパス
VITE_SHAPE_PROXY_PATH=/api/shapes

# OIDC ログイン（AuthZ）。VITE_OIDC_ISSUER と VITE_OIDC_CLIENT_ID を設定すると、
# 開発時も X-Dev-User ではなく Authorization: Bearer で認証します。未設定なら従来の
# dev ユーザーで動きます。以下はローカル AuthZ の例です。
# 本番 issuer: https://account.zli.works/api/auth
# VITE_OIDC_ISSUER=http://localhost:4321/api/auth
# VITE_OIDC_CLIENT_ID=<AuthZ で登録した public client ID>
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
#
# AuthZ の resource（RFC 8707）。設定すると authorize と token 要求の両方に付与され、
# access token が typ: at+jwt の JWT になります。未設定だと AuthZ は opaque token を
# 発行します。本番の resource identifier は https://zoo2.zli.works です。ローカルは
# AuthZ 側の oauthResource に登録し、oauthClientResource で client に紐付けた値に
# してください。
# VITE_OIDC_RESOURCE=https://zoo2.zli.works
#
# AuthZ が提供する scope は openid profile のみです。email と offline_access は
# 非対応で、refresh token は発行されません。ains は必要になった時点で追加します。
# VITE_OIDC_SCOPE=openid profile
#
# バックエンドの OIDC_AUDIENCE には、ここで設定した resource identifier を指定して
# ください（AuthZ の access token の aud は resource の配列です）。resource を設定
# しない場合、opaque token のためバックエンドの JWT 検証は通りません。
#
# ログアウトは discovery の end_session_endpoint（RP-initiated logout）を使います。
