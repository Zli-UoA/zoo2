# Shape 接続先の切替: proxy = バックエンドの Shape プロキシ経由 (既定・本番と同じ経路) /
# direct = Electric 直結 (開発専用・認可を迂回)
# 未設定なら proxy。不正な値は起動時にエラーになります。
VITE_SHAPE_MODE=proxy

# proxy モードの開発では必須: 現在ユーザー (X-Dev-User ヘッダ)。DB の users に存在する
# ユーザーの id を指定してください。未設定だと proxy モードの開発は起動時にエラーになります
# (direct では不要)。バックエンドの DEV_DEFAULT_USER_ID (既定 00000000-0000-0000-0000-000000000001)
# と同じ値にすると、ヘッダが無いときの既定ユーザーと一致します。
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# 書き込み後の楽観更新の待ち方: awaitTxId (既定) / awaitMatch / skip
# awaitTxId は REST が返す txid を Electric が配信するまで待つ。txid 非対応環境では
# awaitMatch (operation と行 id で照合) や skip (待機しない) に切り替えられます。
VITE_TXID_MODE=awaitTxId

# direct モードで参照する Electric の Shape エンドポイント
VITE_ELECTRIC_SHAPE_URL=http://localhost:3000/v1/shape

# REST API と proxy モードのベース URL
VITE_API_BASE_URL=http://localhost:8000

# Shape プロキシのパス
VITE_SHAPE_PROXY_PATH=/api/shapes
