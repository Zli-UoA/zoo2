# Environment: 'development' | 'production' | 'test'
# IMPORTANT: In production environments, always set ENVIRONMENT=production.
# When ENVIRONMENT=production, DEV_AUTH_ENABLED is strictly forced to false (fail-closed).
ENVIRONMENT=development
DEV_AUTH_ENABLED=true

# Database & Electric Sync
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=zoo
POSTGRES_PORT=5432
ELECTRIC_VERSION=1.8.1
ELECTRIC_PORT=3000

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
ELECTRIC_URL=http://localhost:${ELECTRIC_PORT}

# CORS allowlist (comma-separated origins)
# Unset defaults: dev frontend origins below when ENVIRONMENT!=production;
# empty (deny all cross-origin) when ENVIRONMENT=production (same-origin
# delivery needs no external origin). Set explicitly to override.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OIDC / Production Auth (Kanidm)
# NOTE: OIDC_ISSUER must exactly match the 'iss' claim in the access token.
# Please verify whether your Kanidm instance configuration has a trailing slash in issuer.
OIDC_ISSUER=https://idm.example.com/oauth2/openid/zoo
OIDC_AUDIENCE=zoo_client
# Client IDs (Web, Android, TUI) accepted as the `aud` of the ID token in X-Zoo-Reauth,
# the re-authentication for E2EE key changes (docs/e2ee.md). Comma-separated.
# If unset, the backend starts but rejects every operation that needs re-authentication.
# OIDC_REAUTH_AUDIENCES=zoo_web,zoo_android,zoo_tui

# Accept `encrypted: true` channels and DMs (docs/e2ee.md). Keep false until the
# plaintext-path rejections of #358 are deployed. `true` or `1` enables it.
# E2EE_ENCRYPTED_CHANNELS_ENABLED=false
# Optional: if omitted, JWKS URI is automatically resolved via OpenID Discovery (/.well-known/openid-configuration)
# OIDC_JWKS_URL=https://idm.example.com/oauth2/openid/zoo/public_key.jwk

# Attachment object storage (S3 / Cloudflare R2).
# Unset defaults: http://localhost:9000 (RustFS in dev). Production requires explicit R2 configuration.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=zoo-attachments-prod
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Optional public endpoint for client-facing presigned URLs (e.g. Cloudflare Worker reverse proxy).
# - Requires S3_FORCE_PATH_STYLE=true.
# - Reverse proxy MUST rewrite the Host header back to S3_ENDPOINT (e.g. <ACCOUNT_ID>.r2.cloudflarestorage.com)
#   when forwarding to R2; otherwise AWS SigV4 verification fails (SignatureDoesNotMatch).
# - If a path prefix is used (e.g. https://attachments.zliusercontent.com/storage), the proxy must strip it before forwarding.
# - When configured, set CSP_STORAGE_SRC below to this public origin.
# S3_PUBLIC_ENDPOINT=https://attachments.zliusercontent.com

# App file uploads (optional; S3-compatible HTTPS endpoint, path-style URLs).
APP_S3_ENDPOINT=
APP_S3_BUCKET=
APP_S3_REGION=
APP_S3_ACCESS_KEY_ID=
APP_S3_SECRET_ACCESS_KEY=
# Space-separated HTTPS origins allowed to serve App icons in production.
CSP_APP_IMAGE_SRC=
# Space-separated HTTPS origins for attachment object storage (e.g. Cloudflare R2 or S3_PUBLIC_ENDPOINT origin) added to connect-src and img-src in production.
CSP_STORAGE_SRC=

# Independently deployed media-proxy-rs public endpoint (frontend container runtime).
MEDIA_PROXY_URL=
# Local Vite development fallback; production uses MEDIA_PROXY_URL above.
VITE_MEDIA_PROXY_URL=

# Public mei23/summaly metadata endpoint; frontend container runtime / local Vite.
SUMMALY_URL=
VITE_SUMMALY_URL=

# Optional ActivityPub federation (canonical public HTTPS origin).
# Local-only Home and channel integration work without this setting.
# ACTIVITYPUB_BASE_URL=https://zoo.example.com

# Enable only on an isolated origin reached exclusively through Cloudflare Tunnel.
# compose.stack.yaml enables this for its loopback-only Tunnel ingress.
ACTIVITYPUB_CLOUDFLARE_TUNNEL=

# Optional WebRTC ICE servers JSON configuration for voice calls (STUN/TURN).
# Defaults to Google public STUN server if unset: [{"urls":["stun:stun.l.google.com:19302"]}]
# WEBRTC_ICE_SERVERS_JSON='[{"urls":["stun:stun.l.google.com:19302"]}]'

# Shared emoji service origin. Unset to retain the legacy local registry.
# EMOJI_SERVICE_URL=https://emoji.example.com
# Persist the last valid catalog across backend restarts (mount a writable volume).
# EMOJI_CACHE_FILE=/data/emoji-catalog.json

# Observability (OpenTelemetry / Prometheus / Structured Logging)
# Log format: 'pretty' | 'json'. Unset defaults to 'json' when ENVIRONMENT=production, 'pretty' otherwise.
# LOG_FORMAT=pretty
# Internal Prometheus /metrics server for zoo_backend (set METRICS_PORT=0 or off to disable).
# METRICS_HOST=0.0.0.0
# METRICS_PORT=9464
# Optional OTLP/HTTP endpoint for Traces/Metrics/Logs (e.g. http://localhost:4318).
# Signal-specific overrides: OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, OTEL_EXPORTER_OTLP_METRICS_ENDPOINT, OTEL_EXPORTER_OTLP_LOGS_ENDPOINT.
# When unset, OTLP export is disabled and local trace_id/span_id log correlation remains active.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional override for OpenTelemetry service.name (defaults to zoo-backend / zoo-dispatcher / zoo-slack-worker).
# OTEL_SERVICE_NAME=
# Optional OpenTelemetry trace sampler configuration (e.g. parentbased_traceidratio / 0.1).
# OTEL_TRACES_SAMPLER=
# OTEL_TRACES_SAMPLER_ARG=
