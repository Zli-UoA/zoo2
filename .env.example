POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=zoo
POSTGRES_PORT=5432
ELECTRIC_VERSION=1.8.1
ELECTRIC_PORT=3000

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
ELECTRIC_URL=http://localhost:${ELECTRIC_PORT}
DEV_AUTH_ENABLED=true

# OIDC / Production Auth (Kanidm)
OIDC_ISSUER=https://idm.example.com/oauth2/openid/zoo
OIDC_AUDIENCE=zoo_client
# Optional: if omitted, JWKS URI is automatically resolved via OpenID Discovery
# OIDC_JWKS_URL=https://idm.example.com/oauth2/openid/zoo/public_key.jwk

